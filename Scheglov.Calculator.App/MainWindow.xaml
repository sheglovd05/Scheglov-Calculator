<Window x:Class="Scheglov.Calculator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Scheglov.Calculator.App.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1020"
        Height="700"
        MinWidth="880"
        MinHeight="620"
        Background="{Binding PageBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        TextInput="OnWindowTextInput"
        PreviewKeyDown="OnWindowKeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>

        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Background" Value="{Binding KeyBrush}" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeySurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeySurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeySurface" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentKeyButton" TargetType="Button" BasedOn="{StaticResource KeyButton}">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding OnAccentBrush}" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FlatSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FlatSurface" Property="Background" Value="{Binding KeyBrush}" />
                                <Setter Property="Foreground" Value="{Binding TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{Binding KeyBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{Binding TextBrush}" />
                <TextBlock Text="{Binding AuthorText}"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Foreground="{Binding MutedBrush}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}"
                        Content="{Binding ThemeButtonText}"
                        Command="{Binding ToggleThemeCommand}" />
                <Button Style="{StaticResource FlatButton}"
                        Content="{Binding LanguageButtonText}"
                        Command="{Binding ToggleLanguageCommand}" />
            </StackPanel>
        </Grid>

        <!-- Дисплей и клавиатура -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{Binding SurfaceBrush}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="22,18"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding ExpressionLabelText}"
                               FontSize="12"
                               Foreground="{Binding MutedBrush}" />

                    <TextBlock Grid.Row="1"
                               Text="{Binding Expression}"
                               MinHeight="46"
                               Margin="0,6,0,0"
                               FontSize="32"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               Foreground="{Binding TextBrush}" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding PreviewText}"
                               MinHeight="40"
                               Margin="0,10,0,0"
                               FontSize="28"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               Foreground="{Binding PreviewBrush}" />

                    <TextBlock Grid.Row="3"
                               Text="{Binding HintText}"
                               FontSize="12"
                               Margin="0,8,0,0"
                               Foreground="{Binding MutedBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyButton}" Content="C" Command="{Binding ClearCommand}" />
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyButton}" Content="CE" Command="{Binding ClearEntryCommand}" />
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource KeyButton}" Content="⌫" Command="{Binding BackspaceCommand}" />
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource KeyButton}" Content="(" Command="{Binding AppendCommand}" CommandParameter="(" />
                <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource KeyButton}" Content=")" Command="{Binding AppendCommand}" CommandParameter=")" />

                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyButton}" Content="7" Command="{Binding AppendCommand}" CommandParameter="7" />
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyButton}" Content="8" Command="{Binding AppendCommand}" CommandParameter="8" />
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource KeyButton}" Content="9" Command="{Binding AppendCommand}" CommandParameter="9" />
                <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource KeyButton}" Content="÷" Command="{Binding AppendCommand}" CommandParameter="/" />
                <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource KeyButton}" Content="^" Command="{Binding AppendCommand}" CommandParameter="^" />

                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyButton}" Content="4" Command="{Binding AppendCommand}" CommandParameter="4" />
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyButton}" Content="5" Command="{Binding AppendCommand}" CommandParameter="5" />
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource KeyButton}" Content="6" Command="{Binding AppendCommand}" CommandParameter="6" />
                <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource KeyButton}" Content="×" Command="{Binding AppendCommand}" CommandParameter="*" />
                <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource KeyButton}" Content="−" Command="{Binding AppendCommand}" CommandParameter="-" />

                <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyButton}" Content="1" Command="{Binding AppendCommand}" CommandParameter="1" />
                <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource KeyButton}" Content="2" Command="{Binding AppendCommand}" CommandParameter="2" />
                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeyButton}" Content="3" Command="{Binding AppendCommand}" CommandParameter="3" />
                <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource KeyButton}" Content="+" Command="{Binding AppendCommand}" CommandParameter="+" />
                <Button Grid.Row="3" Grid.Column="4" Grid.RowSpan="2" Style="{StaticResource AccentKeyButton}" Content="=" Command="{Binding EvaluateCommand}" />

                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource KeyButton}" Content="0" Command="{Binding AppendCommand}" CommandParameter="0" />
                <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource KeyButton}" Content="." Command="{Binding AppendCommand}" CommandParameter="." />
            </Grid>
        </Grid>

        <!-- Журнал -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{Binding SurfaceBrush}"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,0,10">
                    <TextBlock Text="{Binding HistoryTitleText}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{Binding TextBrush}" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource FlatButton}"
                            Content="{Binding ClearHistoryText}"
                            Command="{Binding ClearHistoryCommand}" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding HistoryRows}"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource HistoryItemButton}"
                                        Command="{Binding DataContext.UseHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Expression}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding DataContext.MutedBrush, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <Grid Grid.Row="1" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Result}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                            <TextBlock Text="{Binding Time}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{Binding DataContext.MutedBrush, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyHistoryText}"
                               Margin="12,20,12,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="{Binding MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HistoryRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
